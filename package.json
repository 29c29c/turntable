{
  "name": "turntable",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web 'npm:dev:api' 'npm:dev:web'",
    "dev:api": "tsx watch --env-file=.env server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "prisma generate && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "node --env-file=.env dist/server/index.js",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "admin:create": "tsx --env-file=.env server/admin.ts",
    "test": "tsx --env-file=.env --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "format": "prettier --write src server tests \"*.{ts,json,yml,md,html}\" scripts/*.mjs .github/workflows/*.yml",
    "format:check": "prettier --check src server tests \"*.{ts,json,yml,md,html}\" scripts/*.mjs .github/workflows/*.yml"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "10.1.6",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.45.1",
    "fastify": "^5.12.7",
    "lucide-react": "^1.56.0",
    "prisma": "6.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "node": "24.21.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "overrides": {
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0"
  }
}
